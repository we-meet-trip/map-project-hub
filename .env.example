# map-project-hub — .env 템플릿
# 실제 값은 `.env` 에 채우고 commit 하지 않는다. 함께 띄울 때는 map-project-infra 의
# .env.example 을 쓴다(같은 이름을 쓴다).
# 이름 규칙: hub 만 읽는 값은 HUB_ 접두, 여러 서비스가 함께 읽는 키·주소·토큰은
# MAP_PROJECT_ 접두. 모르는 이름은 조용히 무시되므로 철자를 확인한다.
#
# **로컬 실행용 기본값이다. 외부에 열기 전에는 반드시 HUB_AUTH_ENFORCED=true 로
# 켜고, MAP_PROJECT_INTERNAL_SERVICE_TOKEN·키·토큰을 직접 정해 넣는다.**
#
# 외부 API 는 키를 넣은 공급자만 부른다. 키가 비어 있으면 그 공급자는 부르지 않고
# 응답에서 '조회 불가'로 나온다. 키 없이 화면을 확인하려면 HUB_PLACES_STUB_MODE=true 로 둔다.

# ── (1) 필수 ────────────────────────────────────────────────────────
# 서비스용 DB 접속(SQLAlchemy 비동기 DSN). 사용자는 런타임 역할 map_hub_runtime 이어야
# 기동 검사를 통과한다(scripts/database-roles.sql). 예:
#   postgresql+psycopg_async://map_hub_runtime:<비밀번호>@postgres:5432/<DB 이름>
HUB_DATABASE_URL=
# 서비스 사이를 오가는 좌표를 감싸는 열쇠. user·agent 와 같은 값을 쓴다.
# 32바이트 base64 — 만드는 법: openssl rand -base64 32
MAP_PROJECT_LOCATION_WIRE_KEY=

# 마이그레이션은 서비스와 따로 한 번 돌린다(서비스 컨테이너에는 넣지 않는다):
#   HUB_MIGRATION_DATABASE_URL=<migrator DSN> python -m map_project_hub.db.migrate

# ── (2) 인증·내부 호출 ─────────────────────────────────────────────
# /internal/* 호출 헤더 X-Internal-Token 과 비교하는 공유 비밀(32자 이상 권장).
MAP_PROJECT_INTERNAL_SERVICE_TOKEN=
# 관리 콘솔이 /internal/grids/*·/internal/forbidden-zones/* 를 부를 때 쓰는 비밀.
MAP_PROJECT_HUB_ADMIN_INTERNAL_TOKEN=
# true 면 /v1/* 공개 endpoint 도 X-Internal-Token 을 요구한다. /health 는 항상 무인증.
# 기본 false(로컬 실행용). 외부에 열 때는 true.
# HUB_AUTH_ENFORCED=false
# /internal/* 를 허용할 CIDR 목록(콤마 구분). 기본은 사설 IP 대역.
# HUB_INTERNAL_TRUSTED_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# 키 없이 고정 스텁 응답으로 확인할 때 true. HUB_AUTH_ENFORCED=true 와 함께 켜면
# 부팅을 거절한다.
# HUB_PLACES_STUB_MODE=false

# ── (3) 기상청 예보·대기오염 ───────────────────────────────────────
# 공공데이터포털 인증키(디코딩 키 권장 — 이중 인코딩 회피). 단기·중기·실황 폴링이 쓴다.
MAP_PROJECT_KMA_SERVICE_KEY=
# 대기오염정보(미세먼지) 키. 비워 두면 기상청 키를 그대로 쓴다.
HUB_AIRKOREA_SERVICE_KEY=
# 조정값(기본값 있음 — 필요할 때만 주석 해제).
# HUB_AIR_POLL_ENABLED=true
# HUB_AIRKOREA_REQUEST_TIMEOUT_SEC=1.5
# HUB_KMA_POLL_INTERVAL_SEC=0.5
# HUB_KMA_RETRY_INTERVAL_SEC=30
# HUB_KMA_RETRY_MAX_DURATION_SEC=1200
# HUB_KMA_REQUEST_TIMEOUT_SEC=10.0
# HUB_KMA_NUMOFROWS=1200
# HUB_KMA_RATE_LIMIT_SLEEP_SEC=2.0
# 실황 스냅샷 보관 일수(어제 기온 비교의 근거).
# HUB_WEATHER_SNAPSHOT_RETENTION_DAYS=3

# ── (4) 장소 — 카카오 로컬 / 두루누비 코스 ────────────────────────
MAP_PROJECT_KAKAO_REST_API_KEY=
# 두루누비(공공데이터포털) 인증키.
MAP_PROJECT_TOUR_API_SERVICE_KEY=

# ── (5) 장소 보강 — 네이버 블로그 후기 ─────────────────────────────
# 자격증명은 요청 헤더(X-Naver-Client-Id / X-Naver-Client-Secret)로만 전달된다.
MAP_PROJECT_NAVER_CLIENT_ID=
MAP_PROJECT_NAVER_CLIENT_SECRET=
# HUB_NAVER_BLOG_TIMEOUT_SEC=3.0
# HUB_NAVER_BLOG_CACHE_TTL_SEC=21600

# ── (6) 장소 보강 — Google 장소 사진 ───────────────────────────────
# 키는 요청 헤더(X-Goog-Api-Key)로만 전달된다. 사진 바이트는 받지 않고 사진 주소와
# 저작자 표시만 전달한다. 이 공급자는 유료 단계가 있다 — 요금 정책은 발급처에서
# 직접 확인하고 아래 하루 상한을 정한다. 0 이면 사진 조회를 끈다.
HUB_GOOGLE_MAPS_API_KEY=
# HUB_GOOGLE_PHOTOS_DAILY_MEDIA_CAP=50
# HUB_GOOGLE_PHOTOS_MAX_COUNT=3
# HUB_GOOGLE_PHOTOS_MAX_WIDTH_PX=800
# HUB_GOOGLE_PLACES_TIMEOUT_SEC=3.0
# HUB_GOOGLE_PLACES_BIAS_RADIUS_M=500
# HUB_GOOGLE_PHOTOS_TOTAL_BUDGET_SEC=4.0
# HUB_GOOGLE_PLACEID_CACHE_TTL_SEC=2592000
# HUB_GOOGLE_PLACEID_NEG_CACHE_TTL_SEC=86400

# ── (7) 대중교통 — ODsay ───────────────────────────────────────────
# 키가 URL 쿼리에 실려 나가므로 오류 본문을 로그에 올릴 때 가린다.
HUB_ODSAY_API_KEY=
# 예비 키. 키에 얽힌 실패에만 한 번 더 부르며 하루 상한을 함께 쓴다.
HUB_ODSAY_API_KEY_FALLBACK=
# 하루 외부 호출 총량. 0 이면 조회를 끈다.
# HUB_ODSAY_DAILY_CALL_CAP=900
# HUB_ODSAY_REQUEST_TIMEOUT_SEC=3.0
# HUB_ODSAY_TOTAL_BUDGET_SEC=4.0
# HUB_ODSAY_CACHE_TTL_SEC=21600
# HUB_ODSAY_FAIL_CACHE_TTL_SEC=60
# HUB_ODSAY_CACHE_COORD_DIGITS=4

# ── (8) 따릉이 대여소 — 서울 열린데이터광장 ───────────────────────
# 발급처가 https 를 받지 않아 이 호출만 평문으로 나간다. 키가 URL 경로에 실리므로
# 오류 본문을 로그에 올릴 때 가린다.
HUB_SEOUL_OPENAPI_KEY=
# HUB_SEOUL_BIKE_CACHE_TTL_SEC=300
# HUB_SEOUL_BIKE_DEFAULT_RADIUS_M=5000

# ── (9) 공유 킥보드 — 국토교통부 퍼스널모빌리티 ───────────────────
# 비어 있으면 기상청 키를 대신 쓴다(같은 발급처의 한 계정 키로 여러 서비스가 열려
# 있는 경우가 흔하다).
HUB_PM_SERVICE_KEY=
# 발급처가 사업자명을 필수로 받고 목록을 주지 않아 기본 목록을 코드에 둔다.
# 바꾸려면 콤마로 적는다. 사업자 이름은 각 사의 상표이며 이 프로젝트와 제휴 관계가 없다.
# HUB_PM_PROVIDERS=
# HUB_PM_CACHE_TTL_SEC=120
# HUB_PM_DEFAULT_RADIUS_M=1000

# ── (10) 도보·자전거 경로 — OSRM ───────────────────────────────────
# 직접 띄운 OSRM 주소. 비어 있으면 경로를 계산하지 않는다(스텁 모드에서는 스텁 경로).
MAP_PROJECT_OSRM_FOOT_BASE_URL=
MAP_PROJECT_OSRM_BICYCLE_BASE_URL=

# ── (11) Redis 캐시 ────────────────────────────────────────────────
# 비밀번호가 있으면 redis://:<비밀번호>@redis:6379 형태로 적는다.
# MAP_PROJECT_REDIS_URL=redis://redis:6379
# 캐시 전용 논리 DB 번호(관리 콘솔도 같은 번호로 진단한다).
# MAP_PROJECT_REDIS_DB_HUB_CACHE=4

# ── (12) 로그 ──────────────────────────────────────────────────────
# HUB_LOG_LEVEL=INFO
